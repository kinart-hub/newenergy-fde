{
  "meta": {
    "version": "1.0.0",
    "updated": "2026-10-10",
    "note": "产线检测设备档案。用于识别导出文件来自哪台设备、把不同版式归一成标准宽表，并把设备私有列名映射到工艺参数。同一份数据若能被多台设备档案命中，取得分最高者；全部未命中时走 _fallback 的通用版式侦测。",
    "layout_vocab": {
      "wide": "标准宽表：一行一样本，一列一检测项",
      "long": "竖表 / Key-Value：检测项名在一列、数值在另一列，需要先 pivot 成宽表",
      "blocked": "单文件内多区块：同一张表里纵向堆叠了若干张子表（例如每个电芯一个区块）"
    }
  },
  "unit_conversions": {
    "mm_to_um": {
      "from": "mm",
      "to": "μm",
      "factor": 1000.0
    },
    "um_to_mm": {
      "from": "μm",
      "to": "mm",
      "factor": 0.001
    },
    "A_to_mA": {
      "from": "A",
      "to": "mA",
      "factor": 1000.0
    },
    "mA_to_A": {
      "from": "mA",
      "to": "A",
      "factor": 0.001
    },
    "ohm_to_mohm": {
      "from": "Ω",
      "to": "mΩ",
      "factor": 1000.0
    },
    "mohm_to_ohm": {
      "from": "mΩ",
      "to": "Ω",
      "factor": 0.001
    },
    "pct_to_ppm": {
      "from": "%",
      "to": "ppm",
      "factor": 10000.0
    },
    "ppm_to_pct": {
      "from": "ppm",
      "to": "%",
      "factor": 0.0001
    },
    "V_to_mV": {
      "from": "V",
      "to": "mV",
      "factor": 1000.0
    },
    "mV_to_V": {
      "from": "mV",
      "to": "V",
      "factor": 0.001
    },
    "kW_to_W": {
      "from": "kW",
      "to": "W",
      "factor": 1000.0
    },
    "mAh_to_Ah": {
      "from": "mAh",
      "to": "Ah",
      "factor": 0.001
    },
    "Ah_to_mAh": {
      "from": "Ah",
      "to": "mAh",
      "factor": 1000.0
    },
    "mW_to_W": {
      "from": "mW",
      "to": "W",
      "factor": 0.001
    },
    "W_to_mW": {
      "from": "W",
      "to": "mW",
      "factor": 1000.0
    }
  },
